    <item android:state_activated="true"><shape><solid android:color="#193B6A"/><stroke android:width="1dp" android:color="#75ACFF"/><corners android:radius="6dp"/><padding android:left="10dp" android:right="10dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#244F92"/><corners android:radius="6dp"/></shape></item>
    <item><shape><solid android:color="#202536"/><corners android:radius="6dp"/><padding android:left="10dp" android:right="10dp"/></shape></item>
</selector>
